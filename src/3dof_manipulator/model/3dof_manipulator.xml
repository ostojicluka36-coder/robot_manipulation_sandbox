<mujoco model='simple 3dof manipulator'>

<!--  <option gravity="0 0 -9.81"/> -->
  <option gravity="0 0 0"/>
  <compiler angle="radian"/>

  <worldbody>
    <light name="top" pos="0 0 10" mode="trackcom"/>
    <body name="first_link" pos="0.0 0.0 1.0">
      <inertial mass="50.0" pos="0.0 0.0 -0.5" diaginertia="0.07707 5.1763 5.1763"/>
      <joint name="first_joint" type="hinge" pos="0.0 0.0 -1.0" axis="0 0 1"/>
      <geom name="first_link_geom" type="cylinder" pos="0.0 0.0 -0.5" size="0.2 0.5" rgba="1.0 0.0 0.0 1.0"/>
      <!-- visual marker -->
      <geom name="first_link_marker" type="box" pos="0.25 0.0 -0.5" size="0.08 0.08 0.08" rgba="1.0 1.0 0.5 1.0"/>
      <!-- -->
      <body name="second_link" pos="0.0 0.0 0.0" euler="-1.57079632679 0.0 0.0">
        <inertial mass="10.0" pos="0.5 0.0 0.0" diaginertia="0.07707 5.1763 5.1763"/>
        <joint name="second_joint" type="hinge" pos="0.0 0.0 0.0" axis="0 0 1"/>
        <geom name="second_link_geom" type="cylinder" pos="0.5 0.0 0.0" euler="0.0 -1.57079632679 0.0" size="0.2 0.5" rgba="0.0 1.0 0.0 1.0"/>
          <body name="third_link" pos="1.0 0.0 0.0">
            <inertial mass="10.0" pos="0.5 0.0 0.0" diaginertia="0.07707 5.1763 5.1763"/>
            <joint name="third_joint" type="hinge" pos="0.0 0.0 0.0" axis="0 0 1"/>
            <geom name="third_link_geom" type="cylinder" pos="0.5 0.0 0.0" euler="0.0 -1.57079632679 0.0" size="0.2 0.5" rgba="0.0 0.0 1.0 1.0"/>
          </body>
      </body>
    </body>
      

  </worldbody>

  <actuator>
    <general name="first_actuator" ctrlrange="-500.0 500.0" joint="first_joint"/>
    <general name="second_actuator" ctrlrange="-500.0 500.0" joint="second_joint"/>
    <general name="third_actuator" ctrlrange="-500.0 500.0" joint="third_joint"/>
  </actuator>

</mujoco>