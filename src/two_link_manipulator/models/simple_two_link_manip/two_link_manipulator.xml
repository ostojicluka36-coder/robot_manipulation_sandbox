<mujoco model="simple two link manipulator">
    
  <option gravity="0 0 -9.81"/>
  <compiler angle="radian"/>

  <worldbody>
    <light name="top" pos="0 0 2" mode="trackcom"/>
    <body name="first_link" pos="0.5 0.0 0.0">
      <inertial mass="61.65" pos="0.0 0.0 0.0" diaginertia="0.07707 5.1763 5.1763"/>
      <joint name="first_joint" type="hinge" pos="-0.5 0.0 0.0" axis="0.0 0.0 1.0"/>
      <geom name="first_link_geom" type="cylinder" pos="0.0 0.0 0.0" euler="0.0 -1.57 0.0" size="0.1 0.5" rgba="1.0 0.0 0.0 1.0"/>
      <body name="second_link" pos="1.0 0.0 0.0">
        <inertial mass="61.65" pos="0.0 0.0 0.0" diaginertia="0.07707 5.1763 5.1763"/>
        <joint name="second_joint" type="hinge" pos="-0.5 0.0 0.0" axis="0.0 0.0 1.0"/>
        <geom name="second_link_geom" type="cylinder" pos="0.0 0.0 0.0" euler="0.0 -1.57 0.0" size="0.1 0.5" rgba="0.0 0.0 1.0 1.0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="first_actuator" ctrlrange="-500.0 500.0" joint="first_joint"/>
    <general name="second_actuator" ctrlrange="-500.0 500.0" joint="second_joint"/>
  </actuator>

</mujoco>